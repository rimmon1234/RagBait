# ==============================================================================
# RagBait Environment Configuration Template
# Copy this file to .env or individual app .env files for local development.
# ==============================================================================

# ------------------------------------------------------------------------------
# Backend API (apps/api)
# ------------------------------------------------------------------------------
PROJECT_NAME="RagBait API"
ENVIRONMENT="development"
DEBUG=true
API_V1_PREFIX="/api/v1"

# Allowed CORS Origins (JSON array or comma-separated list)
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Database Connection (Supabase PostgreSQL asyncpg connection string)
# Local Supabase default: postgresql://postgres:postgres@127.0.0.1:54322/postgres
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:54322/postgres"

# Supabase Auth & JWT Configuration
SUPABASE_URL="http://127.0.0.1:54321"
SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
SUPABASE_JWT_SECRET="your-jwt-secret-at-least-32-chars-long"

# Redis Configuration (Distributed Rate Limiting & Presence)
REDIS_URL="redis://127.0.0.1:6379/0"
RATE_LIMIT_ENABLED=true

# Rate Limits (Requests per minute per principal)
RATE_LIMIT_DEFAULT=60
RATE_LIMIT_HEARTBEAT=1
RATE_LIMIT_ADMIN_READ=60
RATE_LIMIT_ADMIN_MUTATE=30

# Presence Settings (seconds)
HEARTBEAT_INTERVAL_SECONDS=60
ACTIVE_THRESHOLD_SECONDS=120

# ------------------------------------------------------------------------------
# Credential Vault & Encryption (M2.2)
# ------------------------------------------------------------------------------
# Dedicated vault database connection (uses ragbait_vault_user; provisioned out-of-band in production)
VAULT_DATABASE_URL="postgresql://ragbait_vault_user:vault_service_secret_pass@127.0.0.1:54322/postgres"
# Master Key for local development KEK derivation (minimum 32 bytes; production requires Cloud KMS)
VAULT_MASTER_KEY="dev-master-vault-kek-secret-key-32chars!"
# Independent HMAC pepper for duplicate key fingerprinting (minimum 32 bytes)
VAULT_PEPPER_SECRET="dev-vault-fingerprint-pepper-secret-32chars!"
KMS_TYPE="local_hkdf"

# ------------------------------------------------------------------------------
# Frontend Web (apps/web)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL="http://127.0.0.1:54321"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
NEXT_PUBLIC_API_URL="http://127.0.0.1:8000"
